---
import {getCollection} from 'astro:content';
import Base from '../layouts/Base.astro';
const hobbies=(await getCollection('hobbies')).sort((a,b)=>a.data.name.localeCompare(b.data.name,'zh-CN'));
const base=import.meta.env.BASE_URL;
const data=hobbies.map(h=>({id:h.id,name:h.data.name,emoji:h.data.emoji,category:h.data.category,intro:h.data.intro,budget:h.data.budget,budgetLevel:h.data.budgetLevel,difficulty:h.data.difficulty,weeklyTime:h.data.weeklyTime||'',mode:h.data.mode,setting:h.data.setting,tags:h.data.tags,try:h.data.threeMinuteTry}));
---
<Base title="兴趣探索测试"><section class="container v17-heading"><div class="kicker">A LITTLE QUIZ, NO LABELS</div><h1>今天的你，<em>想试点什么？</em></h1><p>五个小问题，帮你从 100 种兴趣里发现几种可能。这不是性格测试，更不是对你的定义。</p></section><section class="container v17-split"><form id="quiz-form" class="v17-panel"><div class="v17-field"><label for="q-budget">01 / 愿意投入多少启动预算？</label><select id="q-budget"><option value="all">先不设限</option><option value="free">能免费尝试最好</option><option value="low">先花一点点</option><option value="medium">愿意适当投入</option></select></div><div class="v17-field"><label for="q-mode">02 / 想一个人，还是和别人一起？</label><select id="q-mode"><option value="all">都可以</option><option value="solo">享受独处</option><option value="social">想认识朋友</option></select></div><div class="v17-field"><label for="q-setting">03 / 今天想待在哪里？</label><select id="q-setting"><option value="all">无所谓</option><option value="indoor">室内</option><option value="outdoor">户外</option></select></div><div class="v17-field"><label for="q-energy">04 / 想要什么样的体验？</label><select id="q-energy"><option value="creative">创造点什么</option><option value="relax">安静放松</option><option value="active">活动身体</option><option value="curious">学点新鲜知识</option></select></div><div class="v17-field"><label for="q-time">05 / 每周大概有多少空闲？</label><select id="q-time"><option value="all">时间灵活</option><option value="short">1–2 小时</option><option value="long">能安排更多时间</option></select></div><button type="submit" class="btn primary">看看我的兴趣灵感 ↗</button></form><div class="v17-panel v17-result"><span class="kicker">A PERSONAL LITTLE LIST</span><h2>你的兴趣灵感</h2><p id="quiz-desc">回答左边的几个问题，就能看到一份为你整理的兴趣清单。</p><div id="quiz-results" class="v17-result-list"></div><button id="quiz-again" class="v17-soft" type="button" hidden>换一批灵感 ↻</button><p class="v17-note">推荐仅按兴趣条目标签进行启发式匹配，不代表能力判断；预算、时长都只是参考。</p></div></section><script define:vars={{data,base}} is:inline>
(()=>{const $=id=>document.getElementById(id);const form=$('quiz-form');let shift=0;let last=[];function score(h,p){let s=0;const text=[h.category,...h.tags,h.intro].join('');const m=h.mode.join(''),st=h.setting.join('');if(p.budget==='all')s+=1;else if(h.budgetLevel===p.budget)s+=4;else if(p.budget==='low'&&h.budgetLevel==='free')s+=3;else if(p.budget==='medium'&&['free','low'].includes(h.budgetLevel))s+=2;if(p.mode==='all')s+=1;else if(p.mode==='solo'&&/独处|单人|个人|独立/.test(m))s+=4;else if(p.mode==='social'&&/社交|多人|双人|结伴|团队/.test(m))s+=4;if(p.setting==='all')s+=1;else if(p.setting==='indoor'&&/室内|居家|不限/.test(st))s+=3;else if(p.setting==='outdoor'&&/户外|自然|室外|不限/.test(st))s+=3;const patterns={creative:/创作|绘画|音乐|摄影|手作|制作|设计|艺术|写作|编程|雕刻|编织/,relax:/生活|自然|园艺|阅读|手账|收藏|茶|咖啡|植物|拼图|观察/,active:/运动|健身|跑步|户外|徒步|羽毛|骑行|游泳|舞蹈|瑜伽/,curious:/知识|思维|科技|天文|历史|语言|科普|研究|学习|科学/};if(patterns[p.energy].test(text))s+=5;if(p.time==='short'&&(/1[–-]2|1小时|2小时|碎片/.test(h.weeklyTime)||h.difficulty==='easy'))s+=2;if(p.time==='long'&&h.difficulty!=='easy')s+=2;return s;}function show(){const p={budget:$('q-budget').value,mode:$('q-mode').value,setting:$('q-setting').value,energy:$('q-energy').value,time:$('q-time').value};last=data.map(h=>({...h,score:score(h,p)})).sort((a,b)=>b.score-a.score||a.name.localeCompare(b.name,'zh-CN'));const top=last.filter(h=>h.score>=last[0].score-3);const picked=[...top.slice(shift%Math.max(1,top.length)),...top.slice(0,shift%Math.max(1,top.length))].slice(0,6);$('quiz-desc').textContent='根据你今天的选择，先看看这几项。喜欢的话只试三分钟也很好。';$('quiz-results').replaceChildren(...picked.map(h=>{const a=document.createElement('a');a.className='v17-mini';a.href=base+'hobbies/'+h.id+'/';const b=document.createElement('strong');b.textContent=h.emoji+' '+h.name;const c=document.createElement('small');c.textContent=h.intro;const d=document.createElement('span');d.textContent='看看怎么开始 ↗';a.append(b,c,d);return a}));$('quiz-again').hidden=false;}form.addEventListener('submit',e=>{e.preventDefault();shift=0;show()});$('quiz-again').addEventListener('click',()=>{shift+=5;show()});})();
</script></Base>