---
import Base from '../layouts/Base.astro';
---
<Base title="分享兴趣"><section class="container contribute-page"><div class="kicker">BUILD THE ATLAS TOGETHER</div><h1>分享一件<span>你喜欢的事。</span></h1><p class="contribute-lead">你发现了一个值得收录的兴趣？或者你有真实的入门体验？欢迎把线索留给这本还在生长的三分钟热度。</p><div class="contribute-layout"><div class="contribute-guidance"><div class="guidance-number">01</div><h2>推荐一种兴趣</h2><p>给我们一个名字、一段简单介绍或一份你觉得不错的入门资源。</p><div class="guidance-number second">02</div><h2>分享真实经验</h2><p>你学过多久？哪些地方很有趣？哪些地方容易踩坑？普通人的体验也值得被记录。</p><div class="notice-box"><strong>目前是投稿演示模式</strong><p>第一版没有服务器，也不会自动保存或上传表单。你可以将整理好的内容复制出来，或保存为文本文件。正式投稿系统将在后续版本接入。</p></div></div><form class="contribute-form" id="contribute-form"><label>分享类型 <select name="type" required><option value="推荐新兴趣">推荐一种新兴趣</option><option value="个人学习经验">个人学习经验</option><option value="教程或资源推荐">教程或资源推荐</option><option value="内容纠错">内容纠错</option></select></label><label>兴趣名称 <input name="hobby" required minlength="2" maxlength="60" placeholder="例如：观鸟、吉他、陶艺" /></label><label>你的标题 <input name="title" required minlength="4" maxlength="100" placeholder="给这份分享起个名字"/></label><label>详细内容 <textarea name="body" required minlength="15" rows="7" placeholder="讲讲这个兴趣的乐趣、学习路径、费用，或你亲自体验后的收获……"></textarea></label><label>参考链接（选填） <input name="link" type="url" placeholder="https://" /></label><div class="form-actions"><button class="btn primary" type="submit">生成投稿文本 ↗</button><button class="btn outline" id="download" type="button" disabled>保存为 TXT</button></div><div id="submission-result" class="submission-result" aria-live="polite" hidden><strong>你的投稿草稿已整理好</strong><p>已在下方生成文本。可以复制或保存到本地；尚未发送给站长。</p><textarea id="draft-output" readonly rows="9"></textarea><button type="button" id="copy" class="btn outline">复制文本</button><p id="copy-status" role="status"></p></div></form></div></section>
<script>
const form=document.querySelector<HTMLFormElement>('#contribute-form')!;const output=document.querySelector<HTMLTextAreaElement>('#draft-output')!;const download=document.querySelector<HTMLButtonElement>('#download')!;const nameField=form.elements.namedItem('hobby') as HTMLInputElement;const h=new URLSearchParams(location.search).get('hobby');if(h)nameField.value=h;
form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const d=new FormData(form);output.value=`【三分钟热度投稿草稿】\n类型：${d.get('type')}\n兴趣：${d.get('hobby')}\n标题：${d.get('title')}\n\n正文：\n${d.get('body')}\n\n参考链接：${d.get('link')||'无'}\n创建日期：${new Date().toLocaleDateString('zh-CN')}`;document.querySelector<HTMLElement>('#submission-result')!.hidden=false;download.disabled=false;document.querySelector('#submission-result')!.scrollIntoView({behavior:'smooth',block:'nearest'});});
document.querySelector('#copy')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(output.value);document.querySelector('#copy-status')!.textContent='复制成功';}catch{output.focus();output.select();document.querySelector('#copy-status')!.textContent='请选择文本手动复制';}});
download.addEventListener('click',()=>{if(!output.value)return;const blob=new Blob([output.value],{type:'text/plain;charset=utf-8'});const u=URL.createObjectURL(blob);const a=document.createElement('a');a.href=u;a.download='三分钟热度-投稿草稿.txt';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);});
</script></Base>
