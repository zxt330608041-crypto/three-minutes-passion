---
import {getCollection} from 'astro:content';
import Base from '../layouts/Base.astro';
import HobbyCard from '../components/HobbyCard.astro';
const all=(await getCollection('hobbies')).sort((a,b)=>a.data.name.localeCompare(b.data.name,'zh-CN'));
const base=import.meta.env.BASE_URL;
const cardData=all.map(h=>({id:h.id,name:h.data.name,category:h.data.category,budget:h.data.budgetLevel,difficulty:h.data.difficulty,mode:h.data.mode,setting:h.data.setting,tags:h.data.tags,weeklyTime:h.data.weeklyTime||'',search:[h.data.name,h.data.intro,...h.data.tags].join(' ')}));
---
<Base title="帮我找兴趣" description="按预算、空闲时间、独处或结伴、室内外偏好，找到适合你现在生活的兴趣。">
<section class="container finder-intro"><div class="kicker">FIND YOUR NEXT LITTLE SPARK</div><h1>下一件想尝试的事，<br/><em>从这里开始。</em></h1><p>不必先知道自己喜欢什么。选几个条件，让兴趣来找你。筛选只是参考，不是给你的热爱设限。</p></section>
<section class="container finder-layout"><aside class="finder-panel"><div class="finder-panel-title"><span>01 / YOUR PREFERENCES</span><h2>你现在想怎么开始？</h2></div><label for="find-budget">启动预算</label><select id="find-budget"><option value="all">预算不限</option><option value="free">免费可试</option><option value="low">低预算</option><option value="medium">适中预算</option><option value="high">较高预算</option></select><label for="find-time">每周可以投入的时间</label><select id="find-time"><option value="all">时间灵活</option><option value="short">碎片时间 / 每周约 1–2 小时</option><option value="steady">愿意每周抽出几小时</option></select><label for="find-mode">偏好的参与方式</label><select id="find-mode"><option value="all">都可以</option><option value="solo">一个人也能玩</option><option value="social">想和别人一起</option></select><label for="find-setting">活动场景</label><select id="find-setting"><option value="all">室内外不限</option><option value="indoor">室内</option><option value="outdoor">户外</option></select><button class="finder-reset" id="finder-reset" type="button">清空条件 ↺</button><p class="finder-disclaimer">预算为已有条目的粗略标签；时间为探索型参考筛选，实际投入因目标而异。</p></aside><div class="finder-results"><div class="finder-top"><div><div class="kicker">02 / DISCOVER</div><h2>或许你会喜欢这些</h2></div><span id="finder-count">{all.length} 种可能</span></div><p class="finder-hint" id="finder-hint">先看看全部兴趣，或者在左侧选择条件。</p><div class="catalog-grid" id="finder-cards">{all.map(h=><div class="finder-item" data-id={h.id}><HobbyCard hobby={h} compact/></div>)}</div><div id="finder-none" class="finder-empty" hidden><span>✳</span><h3>暂时没有完全符合的兴趣</h3><p>不妨放宽一个条件，说不定就会有意外发现。</p></div></div></section>
<script define:vars={{cardData}} is:inline>
(function(){const data=cardData, items=[...document.querySelectorAll('.finder-item')];const $=id=>document.getElementById(id);const fields=['find-budget','find-time','find-mode','find-setting'].map($);const params=new URLSearchParams(location.search);const presets={free:{'find-budget':'free'},weekend:{'find-time':'short'},curious:{'find-budget':'low'}};const preset=params.get('preset');if(presets[preset])for(const [id,v] of Object.entries(presets[preset]))$(id).value=v;
function matchesTime(h,time){if(time==='all'||time==='steady')return true;const s=h.weeklyTime||'';const numbers=[...s.matchAll(/\d+(?:\.\d+)?/g)].map(x=>Number(x[0]));if(numbers.length)return numbers[0]<=2;return true;}
function matchesMode(h,mode){if(mode==='all')return true;const text=(h.mode||[]).join(' ');return mode==='solo'?/独处|单人|个人|独立/.test(text):/社交|多人|结伴|双人|团队|团体/.test(text);}
function matchesSetting(h,setting){if(setting==='all')return true;const text=(h.setting||[]).join(' ');return setting==='indoor'?/室内|居家|不限/.test(text):/户外|室外|自然|不限/.test(text);}
function apply(){const [budget,time,mode,setting]=fields.map(x=>x.value);let n=0;for(let i=0;i<data.length;i++){const h=data[i],ok=(budget==='all'||h.budget===budget)&&matchesTime(h,time)&&matchesMode(h,mode)&&matchesSetting(h,setting);items[i].hidden=!ok;if(ok)n++} $('finder-count').textContent=n+' 种可能';$('finder-none').hidden=n!==0;$('finder-hint').textContent=n===0?'换一种组合试试看。':n<=10?'这些兴趣和你的条件比较接近，可以点开看看三分钟尝试。':'探索结果按名称排序；选择更多偏好可进一步缩小范围。';}
for(const el of fields)el.addEventListener('change',apply);$('finder-reset').addEventListener('click',()=>{for(const x of fields)x.value='all';history.replaceState(null,'',location.pathname);apply();});apply()})();
</script>
</Base>
