---
import {getCollection} from 'astro:content';
import Base from '../layouts/Base.astro';
const hobbies=(await getCollection('hobbies')).sort((a,b)=>a.data.name.localeCompare(b.data.name,'zh-CN'));
const base=import.meta.env.BASE_URL;
const data=hobbies.map(h=>({id:h.id,name:h.data.name,emoji:h.data.emoji,category:h.data.category,intro:h.data.intro,budget:h.data.budget,budgetLevel:h.data.budgetLevel,difficulty:h.data.difficulty,weeklyTime:h.data.weeklyTime||'',mode:h.data.mode,setting:h.data.setting,tags:h.data.tags,try:h.data.threeMinuteTry}));
---
<Base title="今日心情推荐"><section class="container v17-heading"><div class="kicker">WHAT FEELS RIGHT TODAY?</div><h1>今天的你，<em>想怎么玩？</em></h1><p>不需要给自己设目标。选一种当下的心情，带走一个几分钟就能开始的小小灵感。</p></section><section class="container v17-panel"><div id="mood-options" class="v17-moods"><button type="button" data-mood="quiet" aria-pressed="true">🌿 想安静一会儿</button><button type="button" data-mood="creative">🎨 想创造点什么</button><button type="button" data-mood="outdoor">☀️ 想出去走走</button><button type="button" data-mood="surprise">✨ 想遇见新鲜事</button></div><div class="v17-mood-result"><span class="kicker">TODAY'S LITTLE IDEA</span><h2 id="mood-title"></h2><p id="mood-intro"></p><div class="v17-try"><strong>✳ 三分钟先试试看</strong><p id="mood-try"></p></div><div class="v17-two"><a id="mood-link" class="btn primary">了解这个兴趣 ↗</a><button type="button" class="btn outline" id="mood-refresh">换一个灵感 ↻</button></div></div></section><script define:vars={{data,base}} is:inline>
(()=>{const $=id=>document.getElementById(id);let mood='quiet',n=0;const groups={quiet:h=>/自然|生活|收藏|知识|手工/.test(h.category)&&!(/攀岩|徒步|骑行/.test(h.name)),creative:h=>/艺术|手工|音乐|科技|表演/.test(h.category),outdoor:h=>h.setting.some(s=>/户外|自然|室外/.test(s))||/运动|户外/.test(h.category),surprise:h=>/微缩|观鸟|拇指|无线电|生态瓶|调香|模型|植物|拓印|像素|橡皮章|矿石|魔方|天文|观云/.test(h.name+' '+h.tags.join(''))};function show(){const filtered=data.filter(groups[mood]);const pool=filtered.length?filtered:data;const h=pool[(Math.floor(Date.now()/86400000)+n*13)%pool.length];$('mood-title').textContent=h.emoji+' '+h.name;$('mood-intro').textContent=h.intro;$('mood-try').textContent=h.try;$('mood-link').href=base+'hobbies/'+h.id+'/';document.querySelectorAll('[data-mood]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.mood===mood)));}document.querySelectorAll('[data-mood]').forEach(b=>b.addEventListener('click',()=>{mood=b.dataset.mood;n=0;show()}));$('mood-refresh').addEventListener('click',()=>{n++;show()});show()})();
</script></Base>