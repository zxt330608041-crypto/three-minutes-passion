---
import {getCollection} from 'astro:content';
import Base from '../layouts/Base.astro';
const hobbies=(await getCollection('hobbies')).sort((a,b)=>a.data.name.localeCompare(b.data.name,'zh-CN'));
const base=import.meta.env.BASE_URL;
const data=hobbies.map(h=>({id:h.id,name:h.data.name,emoji:h.data.emoji,category:h.data.category,intro:h.data.intro,budget:h.data.budget,budgetLevel:h.data.budgetLevel,difficulty:h.data.difficulty,weeklyTime:h.data.weeklyTime||'',mode:h.data.mode,setting:h.data.setting,tags:h.data.tags,try:h.data.threeMinuteTry}));
---
<Base title="我的兴趣探索护照"><section class="container v17-heading"><div class="kicker">A PASSPORT FOR CURIOSITY</div><h1>我的兴趣<em>探索护照。</em></h1><p>每发现一件有趣的事，就留下一枚小印章。这里没有毕业、失败或排行榜，只记录你的好奇心去过哪里。</p></section><section class="container v17-passport-grid"><div class="v17-panel"><div class="kicker">MY LITTLE JOURNEY</div><h2>我的探索记录</h2><div class="v17-stats"><div><strong id="passport-stamps">0</strong><small>已探索</small></div><div><strong id="passport-tried">0</strong><small>正在 / 曾经尝试</small></div><div><strong id="passport-categories">0</strong><small>涉足领域</small></div></div><p class="v17-note">印章储存在当前浏览器；「正在发热」「曾经热爱」统计自动读取 V1.6 兴趣足迹。</p><h3>最近留下的印章</h3><div id="passport-owned" class="v17-stamp-list"></div></div><div class="v17-panel"><div class="kicker">COLLECT YOUR NEXT STAMP</div><h2>今天想探索哪一种？</h2><label class="v17-label" for="passport-search">按名称寻找</label><input id="passport-search" type="search" placeholder="例如：吉他、观鸟、像素画" /><div id="passport-options" class="v17-stamp-list"></div><p id="passport-alert" class="v17-note" role="status"></p></div></section><script define:vars={{data,base}} is:inline>
(()=>{const KEY='three-minutes-passion:passport:v1',FOOT='three-minutes-passion:footprints:v1';const $=id=>document.getElementById(id);function load(key){try{return JSON.parse(localStorage.getItem(key)||'{}')}catch{return {}}}let stamps=load(KEY);if(!stamps||typeof stamps!=='object'||Array.isArray(stamps))stamps={};const foot=load(FOOT);function stampButton(h,owned){const box=document.createElement('div');box.className='v17-stamp';const a=document.createElement('a');a.href=base+'hobbies/'+h.id+'/';a.textContent=h.emoji+' '+h.name;const btn=document.createElement('button');btn.type='button';btn.textContent=owned?'已盖章 ✓':'盖一枚探索章 ✳';btn.disabled=owned;btn.addEventListener('click',()=>{stamps[h.id]=new Date().toISOString();try{localStorage.setItem(KEY,JSON.stringify(stamps));$('passport-alert').textContent='已为 '+h.name+' 盖上一枚探索章！'}catch{$('passport-alert').textContent='本地存储不可用，无法保存印章。'}render()});box.append(a,btn);return box;}function render(){const ids=Object.keys(stamps).filter(id=>data.some(h=>h.id===id));$('passport-stamps').textContent=ids.length;const tried=Object.entries(foot||{}).filter(([id,v])=>data.some(h=>h.id===id)&&['active','past'].includes(v?.status));$('passport-tried').textContent=tried.length;const total=new Set([...ids,...tried.map(v=>v[0])].map(id=>data.find(h=>h.id===id)?.category).filter(Boolean));$('passport-categories').textContent=total.size;const owned=$('passport-owned');owned.replaceChildren();if(!ids.length){const p=document.createElement('p');p.className='v17-note';p.textContent='你的护照还是空白的。选一个感兴趣的条目，盖下第一枚章吧。';owned.append(p)}else ids.sort((x,y)=>String(stamps[y]).localeCompare(String(stamps[x]))).slice(0,25).forEach(id=>owned.append(stampButton(data.find(h=>h.id===id),true)));const q=$('passport-search').value.trim();const options=data.filter(h=>!stamps[h.id]&&(!q||[h.name,h.category,h.intro].join(' ').includes(q))).slice(0,12);$('passport-options').replaceChildren(...options.map(h=>stampButton(h,false)));if(!options.length){const p=document.createElement('p');p.className='v17-note';p.textContent='没有匹配的未探索条目，试试其他名称。';$('passport-options').append(p)}}$('passport-search').addEventListener('input',render);window.addEventListener('storage',render);render()})();
</script></Base>