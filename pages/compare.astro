---
import {getCollection} from 'astro:content';
import Base from '../layouts/Base.astro';
const hobbies=(await getCollection('hobbies')).sort((a,b)=>a.data.name.localeCompare(b.data.name,'zh-CN'));
const base=import.meta.env.BASE_URL;
const data=hobbies.map(h=>({id:h.id,name:h.data.name,emoji:h.data.emoji,category:h.data.category,intro:h.data.intro,budget:h.data.budget,budgetLevel:h.data.budgetLevel,difficulty:h.data.difficulty,weeklyTime:h.data.weeklyTime||'',mode:h.data.mode,setting:h.data.setting,tags:h.data.tags,try:h.data.threeMinuteTry}));
---
<Base title="兴趣对比实验室"><section class="container v17-heading"><div class="kicker">SIDE BY SIDE</div><h1>两个兴趣，<em>放在一起看看。</em></h1><p>选两种感兴趣的事情，比较入门费用、学习门槛和体验方式。没有绝对的赢家，只有更适合当下的选择。</p></section><section class="container v17-panel v17-compare"><div class="v17-two"><label>兴趣 A<select id="compare-a"></select></label><span class="v17-versus">VS</span><label>兴趣 B<select id="compare-b"></select></label></div><p id="compare-message" class="v17-note" role="status"></p><div class="v17-table-wrap"><table class="v17-table"><thead><tr><th>比较维度</th><th id="compare-name-a"></th><th id="compare-name-b"></th></tr></thead><tbody id="compare-body"></tbody></table></div><div class="v17-two v17-links"><a class="btn outline" id="compare-link-a">了解兴趣 A ↗</a><a class="btn outline" id="compare-link-b">了解兴趣 B ↗</a></div><p class="v17-note">资料来自兴趣条目，预算不等于实时报价；时间投入与难度会随个人目标变化。</p></section><script define:vars={{data,base}} is:inline>
(()=>{const a=document.getElementById('compare-a'),b=document.getElementById('compare-b');for(const h of data){for(const el of [a,b]){const op=document.createElement('option');op.value=h.id;op.textContent=h.emoji+' '+h.name;el.append(op)}}a.value=data.find(x=>x.id==='guitar')?.id||data[0].id;b.value=data.find(x=>x.id==='photography')?.id||data[1].id;function render(){const x=data.find(h=>h.id===a.value),y=data.find(h=>h.id===b.value);if(!x||!y)return;document.getElementById('compare-message').textContent=x.id===y.id?'选了同一种兴趣，可以换一个对比对象。':'每种兴趣都没有标准答案，看看它们各自适合什么样的生活。';document.getElementById('compare-name-a').textContent=x.emoji+' '+x.name;document.getElementById('compare-name-b').textContent=y.emoji+' '+y.name;const rows=[['简单介绍','intro'],['入门预算','budget'],['学习难度','difficulty'],['每周时间参考','weeklyTime'],['活动环境','setting'],['参与方式','mode'],['三分钟尝试','try']];const labels={easy:'较易入门',medium:'需要练习',hard:'有一定挑战'};const body=document.getElementById('compare-body');body.replaceChildren();for(const [label,key] of rows){const tr=document.createElement('tr');const vals=[label,...[x,y].map(h=>Array.isArray(h[key])?h[key].join(' / ')||'未标注':key==='difficulty'?labels[h[key]]||'未标注':h[key]||'未标注')];for(const val of vals){const td=document.createElement('td');td.textContent=val;tr.append(td)}body.append(tr)}for(const [el,h] of [[document.getElementById('compare-link-a'),x],[document.getElementById('compare-link-b'),y]])el.href=base+'hobbies/'+h.id+'/';const u=new URL(location.href);u.searchParams.set('a',x.id);u.searchParams.set('b',y.id);history.replaceState(null,'',u.pathname+u.search);}const params=new URLSearchParams(location.search);if(data.some(h=>h.id===params.get('a')))a.value=params.get('a');if(data.some(h=>h.id===params.get('b')))b.value=params.get('b');a.addEventListener('change',render);b.addEventListener('change',render);render();})();
</script></Base>