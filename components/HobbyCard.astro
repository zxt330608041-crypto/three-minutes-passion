---
import type { CollectionEntry } from 'astro:content';
import {diffLabel,url} from '../lib/site';
const {hobby,compact=false} = Astro.props as {hobby:CollectionEntry<'hobbies'>,compact?:boolean};
const d = hobby.data;
const base = import.meta.env.BASE_URL;
---
<a class={`hobby-card ${compact?'compact':''}`} href={url(hobby.id,base)}>
 <div class="card-image" style={d.image?`background-image:linear-gradient(0deg, rgba(22,30,22,.19), transparent 55%), url('${d.image}')`:''}>
  <span class="image-glyph">{d.emoji}</span>
  {d.level==='guide'&&<span class="image-badge">深度指南</span>}
 </div>
 <div class="card-body"><div class="card-eyebrow">{d.category} <span>·</span> {diffLabel[d.difficulty]}</div><div class="card-title">{d.name}<span>↗</span></div><p>{d.intro}</p><div class="card-bottom"><span>{d.budget}</span><span>{d.tags.slice(0,2).join(' / ')}</span></div></div>
</a>
